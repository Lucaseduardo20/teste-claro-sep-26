{
  "extends": "@repo/tsconfig/nest.json",
  "compilerOptions": {
    // `paths` fica aqui porque os caminhos são relativos a este arquivo.
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vitest/globals", "node"],

    // Relativo a este arquivo, não ao config compartilhado.
    "outDir": "./dist"
  },
  "include": ["src", "test", "prisma", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
